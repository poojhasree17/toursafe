{
  "name": "toursafe-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter web dev",
    "dev:ai": "pnpm --filter ai dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{js,ts,tsx,md}\"",
    "test": "turbo run test",
    "test:web": "pnpm --filter web test",
    "test:web:ui": "pnpm --filter web test:ui",
    "test:web:run": "pnpm --filter web test:run",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rmdir /s .turbo node_modules 2>nul || true",
    "seed": "pnpm --filter scripts seed",
    "simulate": "pnpm --filter scripts simulate",
    "simulate-incidents": "pnpm --filter scripts simulate-incidents",
    "demo": "pnpm --filter scripts demo",
    "install:ai": "cd apps/ai && pip install -r requirements.txt",
    "start:ai": "cd apps/ai && python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload"
  },
  "devDependencies": {
    "@turbo/gen": "^1.12.4",
    "prettier": "^3.2.5",
    "turbo": "^1.12.4",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "tailwindcss-animate": "^1.0.7"
  }
}